DATABASE_URL="postgresql://USER:PASSWORD@HOST_POOLER/neondb?sslmode=require&channel_binding=require&connection_limit=5&pool_timeout=10&connect_timeout=10"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"
SESSION_SECRET="troque-esta-chave-em-producao-com-mais-de-32-caracteres"

# Processadora de pagamentos (Asaas)
# Chave de API: Asaas > Integracoes > Chave de API. Use a chave do Sandbox para testar.
ASAAS_API_KEY=""
# sandbox (padrao) ou production
ASAAS_ENVIRONMENT="sandbox"
# Token definido ao cadastrar o webhook no Asaas. Enviado no header asaas-access-token.
# O Asaas so exibe esse valor no momento da criacao do webhook. Minimo de 16 caracteres.
ASAAS_WEBHOOK_TOKEN=""
# Obrigatorio para contas criadas apos 13/06/2024. Identifica a aplicacao nas requisicoes.
ASAAS_USER_AGENT="Zelo"

# Contas demo. Sem valor padrao de proposito: senha fixa no repositorio vira
# conta publica na producao de qualquer um que clone o projeto.
# Gere a senha com:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
DEMO_PASSWORD=""
DEMO_EMAIL_BASIC=""
DEMO_EMAIL_MANAGEMENT=""
DEMO_EMAIL_COMPLETE=""
